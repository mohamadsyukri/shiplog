APP_NAME="Laravel Template"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://laravel-template.local

# Screens are in Malay; anything not translated falls back to English.
APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Defaults match github.com/mohamadsyukri/docker-webstack (mysql-local, redis, mailpit).
DB_CONNECTION=mysql
DB_HOST=mysql-local
DB_PORT=3306
DB_DATABASE=laravel_template
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# First administrator, created by AdminUserSeeder. Leave the password empty to get a random one,
# printed once when the seeder runs.
ADMIN_NAME="Pentadbir Sistem"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# PDF export (laravel-snappy). The webstack PHP image ships wkhtmltopdf here.
WKHTML_PDF_BINARY=/usr/local/bin/wkhtmltopdf
WKHTML_IMG_BINARY=/usr/local/bin/wkhtmltoimage

VITE_APP_NAME="${APP_NAME}"
